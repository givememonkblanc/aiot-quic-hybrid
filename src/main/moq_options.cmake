# MoQ experiment options. Included after idf_component_register.
set(AIOT_MOQT_POLICY "1" CACHE STRING "MoQ selector 0..5; 6 schedules by the draft-21 wire priorities")
set(AIOT_MOQT_FIFO_ADMISSION "0" CACHE STRING "Preview pending FIFO instead of latest")
set(AIOT_MOQT_PREVIEW_DEADLINE_MS "2000" CACHE STRING "Preview object deadline in milliseconds")
set(AIOT_MOQT_AI_DEADLINE_MS "5000" CACHE STRING "AI result deadline in milliseconds")
if(NOT AIOT_MOQT_POLICY MATCHES "^[0-6]$" OR NOT AIOT_MOQT_FIFO_ADMISSION MATCHES "^[01]$" OR
   NOT AIOT_MOQT_PREVIEW_DEADLINE_MS MATCHES "^[1-9][0-9]*$" OR
   NOT AIOT_MOQT_AI_DEADLINE_MS MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "Invalid MoQ policy/admission")
endif()
target_compile_definitions(${COMPONENT_LIB} PRIVATE
    AIOT_MOQT_POLICY=${AIOT_MOQT_POLICY}
    AIOT_MOQT_FIFO_ADMISSION=${AIOT_MOQT_FIFO_ADMISSION}
    AIOT_MOQT_PREVIEW_DEADLINE_MS=${AIOT_MOQT_PREVIEW_DEADLINE_MS}
    AIOT_MOQT_AI_DEADLINE_MS=${AIOT_MOQT_AI_DEADLINE_MS})

set(AIOT_MOQT_REPRESENTATION "0" CACHE STRING "Representation: 0 high, 1 low, 2 deadline-feasible, 3 medium, 4 throughput rule")
set(AIOT_MOQT_LADDER_DIR "" CACHE PATH "Frozen same-source representation directory")
option(AIOT_MOQT_TRANSCODE "Profile on-device JPEG representation generation" OFF)
option(AIOT_MOQT_ASYNC_CODEC "Single-flight JPEG worker, core 0 priority 1" OFF)
option(AIOT_MOQT_CODEC_PIPELINE "Overlap one conversion with the copied active image TX" OFF)
if(AIOT_MOQT_CODEC_PIPELINE AND NOT AIOT_MOQT_ASYNC_CODEC)
    message(FATAL_ERROR "Codec/TX overlap requires the single-flight worker")
endif()
target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_MOQT_CODEC_PIPELINE=$<BOOL:${AIOT_MOQT_CODEC_PIPELINE}>)
if(AIOT_MOQT_ASYNC_CODEC AND NOT AIOT_MOQT_TRANSCODE)
    message(FATAL_ERROR "Async codec requires runtime transcoding")
endif()
target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_MOQT_ASYNC_CODEC=$<BOOL:${AIOT_MOQT_ASYNC_CODEC}>)
option(AIOT_MOQT_SAFE_START "Start adaptive media at the smallest representation until ACK service is known" OFF)
target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_MOQT_SAFE_START=$<BOOL:${AIOT_MOQT_SAFE_START}>)
option(AIOT_MOQT_EVENT_EVIDENCE "Use JPEG track for exact-source detected-event evidence instead of continuous preview" OFF)
if(AIOT_MOQT_EVENT_EVIDENCE AND NOT AIOT_MOQT_POLICY_EXPERIMENT)
    message(FATAL_ERROR "Event evidence requires the source-sequenced AI event queue")
endif()
target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_MOQT_EVENT_EVIDENCE=$<BOOL:${AIOT_MOQT_EVENT_EVIDENCE}>)
if(AIOT_MOQT_TRANSCODE)
    if(AIOT_MOQT_LADDER_DIR)
        message(FATAL_ERROR "Runtime conversion and offline ladder must be separate experiments")
    endif()
    target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_MOQT_TRANSCODE=1)
endif()
if(NOT AIOT_MOQT_REPRESENTATION MATCHES "^[0-4]$")
    message(FATAL_ERROR "Invalid MoQ representation")
endif()
if(AIOT_MOQT_LADDER_DIR)
    if(NOT AIOT_MOQT_REPLAY_INPUT OR NOT AIOT_MOQT_CONCURRENT)
        message(FATAL_ERROR "Offline ladder is replay-only; cannot substitute for live camera frames")
    endif()
    if(NOT AIOT_REPLAY_JPEG STREQUAL "${AIOT_MOQT_LADDER_DIR}/high.jpg")
        message(FATAL_ERROR "AI replay and media ladder must have the same source")
    endif()
    target_add_binary_data(${COMPONENT_LIB} "${AIOT_MOQT_LADDER_DIR}/medium.jpg" BINARY RENAME_TO moq_medium)
    target_add_binary_data(${COMPONENT_LIB} "${AIOT_MOQT_LADDER_DIR}/low.jpg" BINARY RENAME_TO moq_low)
    target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_MOQT_LADDER=1)
elseif(NOT AIOT_MOQT_REPRESENTATION STREQUAL "0" AND NOT AIOT_MOQT_TRANSCODE)
    message(FATAL_ERROR "Non-high replay representation requires a ladder")
endif()
target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_MOQT_REPRESENTATION=${AIOT_MOQT_REPRESENTATION})

option(AIOT_MOQT_WIRE_PROFILE "Draft-21 profile: object properties, wire priorities and timeouts, evidence track, status datagrams" OFF)
set(AIOT_MOQT_EVIDENCE_DELIVERY "0" CACHE STRING "Evidence delivery: 0 pushed to subscribers, 1 retained and served by FETCH only")
if(NOT AIOT_MOQT_EVIDENCE_DELIVERY MATCHES "^[01]$")
    message(FATAL_ERROR "AIOT_MOQT_EVIDENCE_DELIVERY must be 0 or 1")
endif()
if(AIOT_MOQT_WIRE_PROFILE AND NOT (AIOT_MOQT_POLICY_EXPERIMENT AND AIOT_MOQT_CONCURRENT))
    message(FATAL_ERROR "AIOT_MOQT_WIRE_PROFILE needs AIOT_MOQT_CONCURRENT and AIOT_MOQT_POLICY_EXPERIMENT")
endif()
if(AIOT_MOQT_EVIDENCE_DELIVERY STREQUAL "1" AND NOT (AIOT_MOQT_WIRE_PROFILE AND AIOT_MOQT_EVENT_EVIDENCE))
    message(FATAL_ERROR "FETCH-only evidence needs AIOT_MOQT_WIRE_PROFILE and AIOT_MOQT_EVENT_EVIDENCE")
endif()
target_compile_definitions(${COMPONENT_LIB} PRIVATE
    AIOT_MOQT_WIRE_PROFILE=$<BOOL:${AIOT_MOQT_WIRE_PROFILE}>
    AIOT_MOQT_EVIDENCE_DELIVERY=${AIOT_MOQT_EVIDENCE_DELIVERY})

option(AIOT_MOQT_MISSION_COUNT "Mission profile: passage events are counted; results are never dropped" OFF)
set(AIOT_MOQT_PASSAGE_LINE "128" CACHE STRING "Counting line in detection coordinates, 0..255")
set(AIOT_MOQT_PASSAGE_AXIS "0" CACHE STRING "Counting axis: 0 compares x, 1 compares y")
set(AIOT_MOQT_PASSAGE_DIRECTION "1" CACHE STRING "Counted direction: 0 both, 1 increasing, 2 decreasing")
set(AIOT_MOQT_PASSAGE_STEP "48" CACHE STRING "Largest displacement of one object between two results")
if(AIOT_MOQT_MISSION_COUNT AND NOT AIOT_MOQT_WIRE_PROFILE)
    message(FATAL_ERROR "AIOT_MOQT_MISSION_COUNT needs AIOT_MOQT_WIRE_PROFILE")
endif()
if(NOT AIOT_MOQT_PASSAGE_LINE MATCHES "^[0-9]+$" OR AIOT_MOQT_PASSAGE_LINE GREATER 255 OR
   NOT AIOT_MOQT_PASSAGE_AXIS MATCHES "^[01]$" OR NOT AIOT_MOQT_PASSAGE_DIRECTION MATCHES "^[012]$" OR
   NOT AIOT_MOQT_PASSAGE_STEP MATCHES "^[0-9]+$" OR AIOT_MOQT_PASSAGE_STEP GREATER 255)
    message(FATAL_ERROR "Invalid passage counter options")
endif()
target_compile_definitions(${COMPONENT_LIB} PRIVATE
    AIOT_MOQT_MISSION_COUNT=$<BOOL:${AIOT_MOQT_MISSION_COUNT}>
    AIOT_MOQT_PASSAGE_LINE=${AIOT_MOQT_PASSAGE_LINE}
    AIOT_MOQT_PASSAGE_AXIS=${AIOT_MOQT_PASSAGE_AXIS}
    AIOT_MOQT_PASSAGE_DIRECTION=${AIOT_MOQT_PASSAGE_DIRECTION}
    AIOT_MOQT_PASSAGE_STEP=${AIOT_MOQT_PASSAGE_STEP})

set(AIOT_MOQT_RECONNECT_LIMIT "0" CACHE STRING "Mission profile: sessions to open after a lost connection; 0 disables")
if(NOT AIOT_MOQT_RECONNECT_LIMIT MATCHES "^[0-9]+$")
    message(FATAL_ERROR "Invalid AIOT_MOQT_RECONNECT_LIMIT")
endif()
if(NOT AIOT_MOQT_RECONNECT_LIMIT STREQUAL "0" AND NOT (AIOT_MOQT_MISSION_COUNT AND AIOT_MOQT_KEEP_CACHE))
    message(FATAL_ERROR "Reconnection needs AIOT_MOQT_MISSION_COUNT and AIOT_MOQT_KEEP_CACHE")
endif()
target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_MOQT_RECONNECT_LIMIT=${AIOT_MOQT_RECONNECT_LIMIT})

option(AIOT_MOQT_PASSAGE_SYNTHETIC "Mission test workload: replayed detections move across the counting line" OFF)
if(AIOT_MOQT_PASSAGE_SYNTHETIC AND NOT AIOT_MOQT_MISSION_COUNT)
    message(FATAL_ERROR "AIOT_MOQT_PASSAGE_SYNTHETIC needs AIOT_MOQT_MISSION_COUNT")
endif()
target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_MOQT_PASSAGE_SYNTHETIC=$<BOOL:${AIOT_MOQT_PASSAGE_SYNTHETIC}>)

set(AIOT_MOQT_MISSION_RESULT_TIMEOUT_MS "0" CACHE STRING "Comparison alternative: results expire this long after capture and are not retained; 0 is the mission rule")
if(NOT AIOT_MOQT_MISSION_RESULT_TIMEOUT_MS MATCHES "^[0-9]+$")
    message(FATAL_ERROR "Invalid AIOT_MOQT_MISSION_RESULT_TIMEOUT_MS")
endif()
target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_MOQT_MISSION_RESULT_TIMEOUT_MS=${AIOT_MOQT_MISSION_RESULT_TIMEOUT_MS})

# Comparison alternatives of the mission profile. The defaults are the profile.
set(AIOT_MOQT_MISSION_RESULT_PRIORITY "32" CACHE STRING "Publisher priority of results; 128 equals the source data")
option(AIOT_MOQT_MISSION_RETAIN "Results are retained for FETCH and gaps are announced" ON)
option(AIOT_MOQT_MISSION_IMAGE_TIMEOUT "Source data expire after AIOT_MOQT_AI_DEADLINE_MS" ON)
if(NOT AIOT_MOQT_MISSION_RESULT_PRIORITY MATCHES "^[0-9]+$" OR AIOT_MOQT_MISSION_RESULT_PRIORITY GREATER 255)
    message(FATAL_ERROR "Invalid AIOT_MOQT_MISSION_RESULT_PRIORITY")
endif()
target_compile_definitions(${COMPONENT_LIB} PRIVATE
    AIOT_MOQT_MISSION_RESULT_PRIORITY=${AIOT_MOQT_MISSION_RESULT_PRIORITY}
    AIOT_MOQT_MISSION_RETAIN=$<BOOL:${AIOT_MOQT_MISSION_RETAIN}>
    AIOT_MOQT_MISSION_IMAGE_TIMEOUT=$<BOOL:${AIOT_MOQT_MISSION_IMAGE_TIMEOUT}>)

option(AIOT_MOQT_PASSAGE_PREDICT "Passage counter: one direction of flow, tracks are looked for where they move to" ON)
option(AIOT_MOQT_PASSAGE_UNSEEN "Passage counter: count an object first seen less than one step past the line" ON)
option(AIOT_MOQT_PASSAGE_SETTLED "Passage counter: count such an object only once the flow is known" ON)
set(AIOT_MOQT_PASSAGE_MISSED "2" CACHE STRING "Passage counter: results a track may go unmatched, 0..8")
if(NOT AIOT_MOQT_PASSAGE_MISSED MATCHES "^[0-8]$")
    message(FATAL_ERROR "Invalid AIOT_MOQT_PASSAGE_MISSED")
endif()
set(AIOT_MOQT_PASSAGE_ASSOC "0" CACHE STRING "Passage counter association: 0 greedy nearest pair; 1 minimum-cost assignment with 2-D velocity per second of capture time and coasting tracks")
if(NOT AIOT_MOQT_PASSAGE_ASSOC MATCHES "^[01]$")
    message(FATAL_ERROR "Invalid AIOT_MOQT_PASSAGE_ASSOC")
endif()
target_compile_definitions(${COMPONENT_LIB} PRIVATE
    AIOT_MOQT_PASSAGE_PREDICT=$<BOOL:${AIOT_MOQT_PASSAGE_PREDICT}>
    AIOT_MOQT_PASSAGE_UNSEEN=$<BOOL:${AIOT_MOQT_PASSAGE_UNSEEN}>
    AIOT_MOQT_PASSAGE_SETTLED=$<BOOL:${AIOT_MOQT_PASSAGE_SETTLED}>
    AIOT_MOQT_PASSAGE_MISSED=${AIOT_MOQT_PASSAGE_MISSED}
    AIOT_MOQT_PASSAGE_ASSOC=${AIOT_MOQT_PASSAGE_ASSOC})

set(AIOT_MOQT_RECONNECT_RETRY_MS "3000" CACHE STRING "A reconnection that is not established after this time starts again; 0 waits for the transport")
if(NOT AIOT_MOQT_RECONNECT_RETRY_MS MATCHES "^[0-9]+$")
    message(FATAL_ERROR "Invalid AIOT_MOQT_RECONNECT_RETRY_MS")
endif()
target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_MOQT_RECONNECT_RETRY_MS=${AIOT_MOQT_RECONNECT_RETRY_MS})

option(AIOT_MOQT_MUS "Mission-utility scheduling of evidence: representation by deadline, rate and conversion time" OFF)
set(AIOT_MOQT_MUS_QUALITY_LOW "115" CACHE STRING "Quality of the low representation, thousandths of the source")
set(AIOT_MOQT_MUS_QUALITY_MEDIUM "491" CACHE STRING "Quality of the medium representation, thousandths of the source")
set(AIOT_MOQT_MUS_MARGIN "1000" CACHE STRING "Share of the estimated service rate that the plan relies on, thousandths")
set(AIOT_MOQT_MUS_STATE_DELAY_MS "0" CACHE STRING "Longest wait of a state result behind evidence in the network, ms; 0: no bound")
option(AIOT_MOQT_MUS_DELAY_WINDOW "The image window follows the queueing delay (smoothed less smallest round trip) against AIOT_MOQT_MUS_STATE_DELAY_MS, instead of the measured rate times the delay" OFF)
option(AIOT_MOQT_MUS_RISK "The plan is valued over the deviation of the service rate" ON)
option(AIOT_MOQT_MUS_AHEAD "The next representation is prepared while an object is under way" ON)
set(AIOT_MOQT_MUS_KEEP "50" CACHE STRING "Quality that another plan must gain before the object under way is abandoned, thousandths")
set(AIOT_MOQT_RUN_SECONDS "60" CACHE STRING "Length of the measured run, 10..600 s")
if(AIOT_MOQT_MUS AND NOT (AIOT_MOQT_MISSION_COUNT AND AIOT_MOQT_EVENT_EVIDENCE AND AIOT_MOQT_TRANSCODE AND AIOT_MOQT_ASYNC_CODEC))
    message(FATAL_ERROR "AIOT_MOQT_MUS needs the mission profile, event evidence, transcoding and the codec worker")
endif()
if(NOT AIOT_MOQT_MUS_QUALITY_LOW MATCHES "^[0-9]+$" OR NOT AIOT_MOQT_MUS_QUALITY_MEDIUM MATCHES "^[0-9]+$" OR
   AIOT_MOQT_MUS_QUALITY_LOW GREATER AIOT_MOQT_MUS_QUALITY_MEDIUM OR AIOT_MOQT_MUS_QUALITY_MEDIUM GREATER 1000)
    message(FATAL_ERROR "Invalid qualities of the evidence representations")
endif()
if(NOT AIOT_MOQT_RUN_SECONDS MATCHES "^[0-9]+$" OR AIOT_MOQT_RUN_SECONDS LESS 10 OR AIOT_MOQT_RUN_SECONDS GREATER 600)
    message(FATAL_ERROR "Invalid AIOT_MOQT_RUN_SECONDS")
endif()
target_compile_definitions(${COMPONENT_LIB} PRIVATE
    AIOT_MOQT_MUS=$<BOOL:${AIOT_MOQT_MUS}>
    AIOT_MOQT_MUS_QUALITY_LOW=${AIOT_MOQT_MUS_QUALITY_LOW}
    AIOT_MOQT_MUS_QUALITY_MEDIUM=${AIOT_MOQT_MUS_QUALITY_MEDIUM}
    AIOT_MOQT_MUS_MARGIN=${AIOT_MOQT_MUS_MARGIN}
    AIOT_MOQT_MUS_KEEP=${AIOT_MOQT_MUS_KEEP}
    AIOT_MOQT_MUS_STATE_DELAY_MS=${AIOT_MOQT_MUS_STATE_DELAY_MS}
    AIOT_MOQT_MUS_DELAY_WINDOW=$<BOOL:${AIOT_MOQT_MUS_DELAY_WINDOW}>
    AIOT_MOQT_MUS_RISK=$<BOOL:${AIOT_MOQT_MUS_RISK}>
    AIOT_MOQT_MUS_AHEAD=$<BOOL:${AIOT_MOQT_MUS_AHEAD}>
    AIOT_MOQT_RUN_SECONDS=${AIOT_MOQT_RUN_SECONDS})

option(AIOT_MOQT_RESULT_BINARY "Results track: the binary result as payload instead of JSON with the result in hexadecimal" OFF)
target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_MOQT_RESULT_BINARY=$<BOOL:${AIOT_MOQT_RESULT_BINARY}>)

option(AIOT_MOQT_MUS_FINE_WINDOW "Scheduler: the evidence window leaves room to send a result within the state delay, and may be below one packet" OFF)
target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_MOQT_MUS_FINE_WINDOW=$<BOOL:${AIOT_MOQT_MUS_FINE_WINDOW}>)
set(AIOT_MOQT_MUS_FIXED_WINDOW "0" CACHE STRING "Scheduler ablation: a constant evidence window in bytes in place of the derived one (0: derived)")
if(NOT AIOT_MOQT_MUS_FIXED_WINDOW MATCHES "^[0-9]+$")
    message(FATAL_ERROR "Invalid AIOT_MOQT_MUS_FIXED_WINDOW")
endif()
target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_MOQT_MUS_FIXED_WINDOW=${AIOT_MOQT_MUS_FIXED_WINDOW})
option(AIOT_MOQT_MUS_WINDOW_BDP "Scheduler: the evidence window adds the bytes on the wire (service rate x smallest round trip)" OFF)
target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_MOQT_MUS_WINDOW_BDP=$<BOOL:${AIOT_MOQT_MUS_WINDOW_BDP}>)

option(AIOT_MOQT_OTA_RUN_POLL "With AIOT_MOQT_OTA_REMOTE: the update server is also polled every 30 s during the run (a blocking request in the publishing loop)" ON)
target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_MOQT_OTA_RUN_POLL=$<BOOL:${AIOT_MOQT_OTA_RUN_POLL}>)
option(AIOT_MQTT_BASELINE "Baseline: the mission publishes over MQTT 3.1.1 with TLS (moq_mqtt_shim.c) instead of MOQT" OFF)
set(AIOT_MQTT_CA "" CACHE FILEPATH "PEM certificate that the MQTT broker presents")
if(AIOT_MQTT_HELPER)
    if(NOT AIOT_MOQT_HELPER OR AIOT_MQTT_BASELINE OR NOT EXISTS "${AIOT_MQTT_CA}")
        message(FATAL_ERROR "AIOT_MQTT_HELPER needs AIOT_MOQT_HELPER and AIOT_MQTT_CA, without AIOT_MQTT_BASELINE")
    endif()
    target_add_binary_data(${COMPONENT_LIB} "${AIOT_MQTT_CA}" TEXT RENAME_TO mqtt_ca_pem)
endif()
if(AIOT_MQTT_BASELINE)
    if(NOT (AIOT_MOQT_WIRE_PROFILE AND AIOT_MOQT_MISSION_COUNT) OR NOT EXISTS "${AIOT_MQTT_CA}")
        message(FATAL_ERROR "AIOT_MQTT_BASELINE needs the mission profile and AIOT_MQTT_CA")
    endif()
    target_add_binary_data(${COMPONENT_LIB} "${AIOT_MQTT_CA}" TEXT RENAME_TO mqtt_ca_pem)
    if(AIOT_MOQT_RATE_EVIDENCE_ONLY)   # the transport's option, read by the MQTT shim's service rate
        target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_MOQT_RATE_EVIDENCE_ONLY=1)
    endif()
endif()
target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_MQTT_BASELINE=$<BOOL:${AIOT_MQTT_BASELINE}>)
option(AIOT_MOQT_MUS_PREDICT "Scheduler: image bytes that drain before the next inference can end are admitted beyond the evidence window" OFF)
target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_MOQT_MUS_PREDICT=$<BOOL:${AIOT_MOQT_MUS_PREDICT}>)
set(AIOT_MOQT_VIDEO_WINDOW_MS "0" CACHE STRING "MBM on the media track (continuous frames, AIOT_MOQT_EVENT_EVIDENCE=OFF): the delay a result may wait behind media bytes in ms (0: off)")
if(NOT AIOT_MOQT_VIDEO_WINDOW_MS MATCHES "^[0-9]+$")
    message(FATAL_ERROR "Invalid AIOT_MOQT_VIDEO_WINDOW_MS")
endif()
target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_MOQT_VIDEO_WINDOW_MS=${AIOT_MOQT_VIDEO_WINDOW_MS})
set(AIOT_MOQT_TRACE_MS "0" CACHE STRING "Training trace of the link for the learned MBM: a [MOQ_TRACE] record every this many ms (0: off)")
if(NOT AIOT_MOQT_TRACE_MS MATCHES "^[0-9]+$")
    message(FATAL_ERROR "Invalid AIOT_MOQT_TRACE_MS")
endif()
target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_MOQT_TRACE_MS=${AIOT_MOQT_TRACE_MS})
option(AIOT_MOQT_TIMEOUT_FROM_CREATION "Base reproduction (implicit adaptation): the delivery timeouts of results and media run from the creation of the Object, not from the capture" OFF)
target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_MOQT_TIMEOUT_FROM_CREATION=$<BOOL:${AIOT_MOQT_TIMEOUT_FROM_CREATION}>)
option(AIOT_MOQT_PASSAGE_TRACE "Per-inference record of the detections and tracks ([MOQ_TRACK]) for event-level recall" ON)
target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_MOQT_PASSAGE_TRACE=$<BOOL:${AIOT_MOQT_PASSAGE_TRACE}>)
set(AIOT_FRAME_TRACE_PORT "0" CACHE STRING "Frame trace: every captured JPEG over TCP to AIOT_NETLOG_HOST at this port (0: off)")
if(NOT AIOT_FRAME_TRACE_PORT MATCHES "^[0-9]+$")
    message(FATAL_ERROR "Invalid AIOT_FRAME_TRACE_PORT")
endif()
target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_FRAME_TRACE_PORT=${AIOT_FRAME_TRACE_PORT})
set(AIOT_MOQT_OFFLOAD_MS "0" CACHE STRING "Offload: one camera frame per this many ms to a helper ESP32 on track offload/jpeg (0: off)")
set(AIOT_MOQT_OFFLOAD_TIMEOUT_MS "1000" CACHE STRING "Offload: delivery timeout of an offloaded frame from its creation")
if(NOT AIOT_MOQT_OFFLOAD_MS MATCHES "^[0-9]+$" OR NOT AIOT_MOQT_OFFLOAD_TIMEOUT_MS MATCHES "^[0-9]+$")
    message(FATAL_ERROR "Invalid offload option")
endif()
target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_MOQT_OFFLOAD_MS=${AIOT_MOQT_OFFLOAD_MS} AIOT_MOQT_OFFLOAD_TIMEOUT_MS=${AIOT_MOQT_OFFLOAD_TIMEOUT_MS})
set(AIOT_MOQT_OFFLOAD_MODE "0" CACHE STRING "Offload: 0 one frame per OFFLOAD_MS; 1 mission-aware (halfway through each local inference, only when a screw nears the line); 2 Vigil (per epoch OFFLOAD_MS the frame of most tracked screws, if it fits in capacity x epoch); 3 Argus (the newest frame to the helper when it ends there first: TD = size / EWMA bandwidth plus OFFLOAD_MS of helper service); 4 Chen (pipelined: the newest frame when the previous transmission has ended and OFFLOAD_MS has passed, if size / EWMA bandwidth + OFFLOAD_MS <= CH_TMAX_MS)")
target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_MOQT_OFFLOAD_MODE=${AIOT_MOQT_OFFLOAD_MODE})
set(AIOT_MOQT_VIGIL_CAPACITY_BPS "0" CACHE STRING "Vigil offload (OFFLOAD_MODE 2): capacity C in bytes/s; 0 the congestion window over the smoothed round trip")
if(NOT AIOT_MOQT_VIGIL_CAPACITY_BPS MATCHES "^[0-9]+$")
    message(FATAL_ERROR "Invalid AIOT_MOQT_VIGIL_CAPACITY_BPS")
endif()
target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_MOQT_VIGIL_CAPACITY_BPS=${AIOT_MOQT_VIGIL_CAPACITY_BPS})
set(AIOT_MOQT_CH_TMAX_MS "5000" CACHE STRING "Chen offload (OFFLOAD_MODE 4): restricted time T_max of a task, transmission plus helper processing")
if(NOT AIOT_MOQT_CH_TMAX_MS MATCHES "^[0-9]+$")
    message(FATAL_ERROR "Invalid AIOT_MOQT_CH_TMAX_MS")
endif()
target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_MOQT_CH_TMAX_MS=${AIOT_MOQT_CH_TMAX_MS})
set(AIOT_MOQT_CH_PROBE_MS "10000" CACHE STRING "Chen offload (OFFLOAD_MODE 4): a frame goes to the helper when none has for this long, so that the rate estimate is measured again")
if(NOT AIOT_MOQT_CH_PROBE_MS MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "Invalid AIOT_MOQT_CH_PROBE_MS")
endif()
target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_MOQT_CH_PROBE_MS=${AIOT_MOQT_CH_PROBE_MS})
set(AIOT_MOQT_OFFLOAD_TASK_MS "0" CACHE STRING "Offload: 0 frames as the offload mode sends them; N>0 a direction task per counted passage, done at the helper on the newest frame, due N ms (T_max) after the passage: the offload mode decides when a frame goes, only while a task is open, and a task lapses at T_max (needs AIOT_MOQT_MISSION_COUNT)")
if(NOT AIOT_MOQT_OFFLOAD_TASK_MS MATCHES "^[0-9]+$")
    message(FATAL_ERROR "Invalid AIOT_MOQT_OFFLOAD_TASK_MS")
endif()
if(AIOT_MOQT_OFFLOAD_TASK_MS AND NOT AIOT_MOQT_MISSION_COUNT)
    message(FATAL_ERROR "AIOT_MOQT_OFFLOAD_TASK_MS needs AIOT_MOQT_MISSION_COUNT")
endif()
target_compile_definitions(${COMPONENT_LIB} PRIVATE AIOT_MOQT_OFFLOAD_TASK_MS=${AIOT_MOQT_OFFLOAD_TASK_MS})
set(AIOT_MOQT_OFFLOAD_RASTER "0" CACHE STRING "Direction task (OFFLOAD_TASK_MS): 0 the newest camera frame; N>0 the passage frame as the detector decoded it (1/8, 200x150), encoded at JPEG quality N when it goes out")
if(NOT AIOT_MOQT_OFFLOAD_RASTER MATCHES "^[0-9]+$" OR AIOT_MOQT_OFFLOAD_RASTER GREATER 100)
    message(FATAL_ERROR "Invalid AIOT_MOQT_OFFLOAD_RASTER")
endif()
set(AIOT_MOQT_SPLIT_LOCAL_MS "0" CACHE STRING "Split inference: the camera infers a frame itself at least every this many ms (0: as the Chen rule leaves it)")
if(NOT AIOT_MOQT_SPLIT_LOCAL_MS MATCHES "^[0-9]+$")
