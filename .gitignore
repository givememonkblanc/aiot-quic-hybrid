.cache/
build/
**/__pycache__/
**/.git

# Local logs and captures
*.log
esp32_logs.txt
monitor_capture.log
*.bin

# ESP-IDF local config backups
sdkconfig.old

# Runtime experiment artifacts containing local network details
experiments/runtime_server_files/

# Host receiver runtime artifacts and local keys
host_receiver/qlog_dir/
host_receiver/certs/key.pem
host_receiver/picoquic/CMakeFiles/
host_receiver/picoquic/CMakeCache.txt
host_receiver/picoquic/Testing/
host_receiver/picoquic/cmake_install.cmake
host_receiver/picoquic/CTestTestfile.cmake
host_receiver/picoquic/DartConfiguration.tcl
host_receiver/picoquic/UpgradeLog.htm
host_receiver/picoquic/valgrind_out.txt

# Generated telemetry analyzer output
experiments/telemetry_analyzer/output/

# Product secrets (never commit real keys/certs)
src/components/transport/server_ca.pem
secure_boot_signing_key.pem
*.pem.key
nvs_keys.bin

# sweep credentials (never commit)
experiments/.sweep_secrets
*.sweepbak
*.prodbak

# receiver runtime outputs
host_receiver/aiot_feed.jsonl
host_receiver/latest.jpg
host_receiver/mqtt_events.csv
host_receiver/*_dgram*.csv

# TCP baseline broker artifacts (never commit certs/keys/generated conf/data)
experiments/tcp_bench/certs/
experiments/tcp_bench/mosquitto.conf
experiments/tcp_bench/*.csv
experiments/tcp_bench/*summary*.json
